# Competition inputs and derived rasters are not checked into Git.
data/inbox/*
data/raw/*
data/processed/*
!data/**/README.md
!data/**/.gitkeep

# Generated submission files and private submission registry.
submissions/*.tif
submissions/*.tiff
submissions/*.json
submissions/archive/*

# Python build/test artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Local credentials/configuration must never be committed.
.env
.env.*
!.env.example
